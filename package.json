{
  "name": "cool-music-player",
  "productName": "Cool Music Player",
  "version": "1.0.0",
  "description": "A secure, local FLAC & MP3 music player with a human-made aesthetic.",
  "main": "src/main.js",
  "author": "You",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "pack": "electron-builder --dir",
    "dist": "electron-builder"
  },
  "devDependencies": {
    "electron": "^31.0.0",
    "electron-builder": "^25.0.0"
  },
  "build": {
    "appId": "com.coolmusic.player",
    "productName": "Cool Music Player",
    "win": {
      "target": "nsis",
      "icon": "build/icon.ico"
    },
    "mac": {
      "target": "dmg",
      "icon": "build/icon.icns"
    },
    "linux": {
      "target": "AppImage",
      "icon": "build/icon.png"
    }
  },
  "allowScripts": {
    "electron@31.7.7": true
  }
}
